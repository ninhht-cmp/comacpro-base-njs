{
  // Prettier is the formatter; format on save.
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  // ESLint only auto-fixes lint (not formatting) so it never fights Prettier.
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
  "eslint.useFlatConfig": true,

  // Use the workspace TypeScript (matches the repo's version, not VS Code's).
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // Tailwind v4: IntelliSense inside cva()/cn() (class-variance-authority + tw-merge).
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],

  // orval output: prevent accidental edits + cut search/watch noise (it's
  // lint/prettier-ignored and regenerated by `pnpm gen:api`).
  "files.readonlyInclude": { "src/lib/api/generated/**": true },
  "search.exclude": {
    "src/lib/api/generated": true,
    ".next": true,
    "playwright-report": true
  },
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/src/lib/api/generated/**": true
  }
}
