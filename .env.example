# ==========================================
# Copy this file to `.env` and fill in the values.
# Client-side variables must be prefixed with NEXT_PUBLIC_. Validation is in src/config/env.ts.
# ===================================================================

# /** App Core */
NEXT_PUBLIC_APP_URL=http://localhost:3000

# /** API & Integrations */
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Mock the API with MSW instead of hitting the backend. Set to `enabled` to
# turn it on (browser worker + server-side interception). Leave unset/`disabled`
# to talk to the real API. Useful for FE work before the backend is ready.
NEXT_PUBLIC_API_MOCKING=disabled

# Codegen-only (read by orval.config.ts, not the app). Source of the OpenAPI
# spec for `pnpm gen:api` — a URL or path. Defaults to ./openapi/openapi.json.
# OPENAPI_SPEC=https://api.example.com/v1/openapi.json

# /** Auth & Security */
# Generate via: `npx auth secret`
AUTH_SECRET=

# Google Sign-In client id (public). When unset, the "Continue with Google"
# button is hidden. Create one in Google Cloud Console → Credentials → OAuth
# client (type: Web), and add your origins (e.g. http://localhost:3000) to
# "Authorized JavaScript origins".
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Shared secret used by `/api/revalidate` to authenticate cache-invalidation
# webhooks from NestJS. Min 16 chars. Generate via:
#   openssl rand -hex 32
# Optional in dev (the route returns 503 when unset). Required in production.
REVALIDATE_SECRET=

# /** Optional (CI/CD) */
# Set to 'true' to bypass env validation during build (e.g., Docker/CI).
# SKIP_ENV_VALIDATION=true
