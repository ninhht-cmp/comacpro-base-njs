# ==========================================
# Copy this file to `.env` and fill in the values.
# Client-side variables must be prefixed with NEXT_PUBLIC_. Validation is in src/config/env.ts.
# ===================================================================

# /** App Core */
NEXT_PUBLIC_APP_URL=http://localhost:3000

# /** API & Integrations */
# SaleNet backend (BE SM Service). Endpoints live under /v1 and every response
# is wrapped in the BaseResDto envelope — see src/lib/api/server-fetch.ts.
API_BASE_URL=https://api.dev.salenet.vn
NEXT_PUBLIC_API_BASE_URL=https://api.dev.salenet.vn

# Mock the API with MSW instead of hitting the backend (server-side
# interception — the app is RSC-first, so all API calls originate there).
#   enabled   → mock everything (no backend needed)
#   paid-only → mock ONLY the money-costing endpoints (signup / forgot-password
#               OTP trigger ZaloOA/SMS sends); the rest hits the real API.
#               Use this to test the signup flow against live data for free.
#   disabled  → real API everywhere (a successful signup SENDS A PAID MESSAGE)
NEXT_PUBLIC_API_MOCKING=disabled

# Codegen-only (read by orval.config.ts, not the app). Source of the OpenAPI
# spec for `pnpm gen:api` — a URL or path. Defaults to ./openapi/openapi.json
# (a committed snapshot of the SaleNet spec below).
# OPENAPI_SPEC=https://api.dev.salenet.vn/docs-json

# /** Auth & Security */
# Generate via: `npx auth secret`
AUTH_SECRET=

# Shared secret used by `/api/revalidate` to authenticate cache-invalidation
# webhooks from NestJS. Min 16 chars. Generate via:
#   openssl rand -hex 32
# Optional in dev (the route returns 503 when unset). Required in production.
REVALIDATE_SECRET=

# /** Observability (optional — unset = no-op) */
# Error tracking (wired once @sentry/nextjs is installed — see instrumentation.ts).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# RUM / Web-Vitals beacon target (e.g. a Route Handler forwarding to Datadog RUM).
# NEXT_PUBLIC_VITALS_ENDPOINT=

# /** Feature flags (optional) */
# Comma-separated flag keys to force ON (see src/config/flags.ts).
# NEXT_PUBLIC_FEATURE_FLAGS=maintenanceBanner

# /** Optional (CI/CD) */
# Set to 'true' to bypass env validation during build (e.g., Docker/CI).
# SKIP_ENV_VALIDATION=true
