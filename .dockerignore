# Everything `next build` doesn't need — keeps the build context (and cache
# invalidation surface) minimal.
.git
.github
node_modules
.next
coverage
playwright-report
test-results
.husky
.vscode
.idea
**/*.test.*
**/*.spec.*
e2e
docs
*.md
.env*
!.env.example
Dockerfile
.dockerignore
# Test/tooling surfaces that never feed the production build.
.storybook
storybook-static
tsconfig.tsbuildinfo
*.log
# Agent/tooling workspaces.
.claude
.agents
.playwright-mcp
